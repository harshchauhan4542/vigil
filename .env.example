# Vigil environment. Copy to `.env` and fill in values locally. Never commit `.env`.
# Every variable is documented; none of the values below are secrets.

# --- PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Accept dashboard-simulated webhooks (signed with the literal id WEBHOOK_ID). Never settles real proposals.
ALLOW_SIMULATED_WEBHOOKS=false

# --- Sandbox accounts used by the seeder (Step 5) ---
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_PERSONAL_EMAIL=
PAYPAL_SANDBOX_PERSONAL_PASSWORD=
# Sandbox test card used by `pnpm seed` for single-step orders. Leave empty for the default test Visa.
SEED_CARD_NUMBER=
SEED_CARD_EXPIRY=

# --- AI ---
ANTHROPIC_API_KEY=
VIGIL_MODEL_INTERACTIVE=claude-sonnet-5
VIGIL_MODEL_BATCH=claude-opus-5-5
AI_DAILY_TOKEN_BUDGET=2000000

# --- AG Studio ---
AG_STUDIO=

# --- Infra ---
# Empty DATABASE_URL = embedded PGlite at ./.data/pglite. Set a postgres:// URL to use real Postgres.
DATABASE_URL=
# Empty REDIS_URL = in-memory cache.
REDIS_URL=
RENDER_API_KEY=
TASK_RUNNER=inline

# --- Vigil ---
VIGIL_MODE=replay
# live only: save responses (scrubbed) for replay. Fixtures go to FIXTURES_DIR and the recordings table.
RECORD=false
FIXTURES_DIR=fixtures/recordings
APPROVAL_HMAC_SECRET=
SESSION_SECRET=
EXECUTION_ENABLED=true
POLICY_PER_ACTION_CAP_USD=500
POLICY_DAILY_CAP_USD=2000
LOG_LEVEL=info
