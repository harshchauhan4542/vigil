  "dependencies": {
    "@vigil/config": "workspace:*",
    "@vigil/core": "workspace:*",
    "@vigil/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vigil/tsconfig": "workspace:*",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
